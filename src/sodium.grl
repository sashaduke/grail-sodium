module sodium;

// Typed bindings to the installed libsodium (https://libsodium.org). Every primitive runs inside
// the audited C library; this module only checks lengths and allocates outputs. Byte views pass
// as libsodium's (pointer, length) pairs; keys, nonces and outputs as bare pointers.

extern "C" lib "sodium" fn sodium_init() -> i32;
extern "C" lib "sodium" fn randombytes_buf(buf: &mut [u8]) -> unit;
extern "C" lib "sodium" fn crypto_aead_chacha20poly1305_ietf_encrypt_detached(
    c: CMutPtr, mac: CMutPtr, maclen: CPtr, m: &[u8], ad: &[u8], nsec: CPtr, npub: CPtr, k: CPtr
) -> i32;
extern "C" lib "sodium" fn crypto_aead_chacha20poly1305_ietf_decrypt_detached(
    m: CMutPtr, nsec: CPtr, c: &[u8], mac: CPtr, ad: &[u8], npub: CPtr, k: CPtr
) -> i32;
extern "C" lib "sodium" fn crypto_aead_xchacha20poly1305_ietf_encrypt_detached(
    c: CMutPtr, mac: CMutPtr, maclen: CPtr, m: &[u8], ad: &[u8], nsec: CPtr, npub: CPtr, k: CPtr
) -> i32;
extern "C" lib "sodium" fn crypto_aead_xchacha20poly1305_ietf_decrypt_detached(
    m: CMutPtr, nsec: CPtr, c: &[u8], mac: CPtr, ad: &[u8], npub: CPtr, k: CPtr
) -> i32;
extern "C" lib "sodium" fn crypto_generichash_blake2b(out: &mut [u8], input: &[u8], key: &[u8]) -> i32;
extern "C" lib "sodium" fn crypto_hash_sha256(out: CMutPtr, input: &[u8]) -> i32;
extern "C" lib "sodium" fn crypto_shorthash_siphash24(out: CMutPtr, input: &[u8], k: CPtr) -> i32;
extern "C" lib "sodium" fn crypto_onetimeauth_poly1305(out: CMutPtr, input: &[u8], k: CPtr) -> i32;
extern "C" lib "sodium" fn crypto_scalarmult_curve25519(q: CMutPtr, n: CPtr, p: CPtr) -> i32;
extern "C" lib "sodium" fn crypto_scalarmult_curve25519_base(q: CMutPtr, n: CPtr) -> i32;
extern "C" lib "sodium" fn crypto_stream_chacha20_ietf_xor_ic(c: CMutPtr, m: &[u8], n: CPtr, ic: u32, k: CPtr) -> i32;
extern "C" lib "sodium" fn crypto_core_hchacha20(out: CMutPtr, input: CPtr, k: CPtr, c: CPtr) -> i32;

pub const KEY_BYTES: u64 = 32;
pub const IETF_NONCE_BYTES: u64 = 12;
pub const XNONCE_BYTES: u64 = 24;
pub const TAG_BYTES: u64 = 16;

fn zeros(n: u64) -> u8[] {
    mut out = u8[];
    for i in n {
        out.push(0);
    }
    return out;
}

// Initialises libsodium; true when it is ready (safe to call more than once).
pub fn init() -> bool {
    mut r: i32 = 0;
    unsafe {
        r = sodium_init();
    }
    return r >= 0;
}

pub fn random_bytes(n: u64) -> u8[] {
    mut out = zeros(n);
    unsafe {
        randombytes_buf(&mut out);
    }
    return out;
}

// Ciphertext followed by the 16-byte tag, or None for a wrong key or nonce length.
pub fn chacha20poly1305_ietf_encrypt<a, b, c, d>(message: &a [u8], ad: &b [u8], nonce: &c [u8], key: &d [u8]) -> u8[]? {
    if (nonce.len() != IETF_NONCE_BYTES) || (key.len() != KEY_BYTES) {
        return None;
    }
    return seal(message, ad, nonce, key, false);
}
pub fn xchacha20poly1305_ietf_encrypt<a, b, c, d>(message: &a [u8], ad: &b [u8], nonce: &c [u8], key: &d [u8]) -> u8[]? {
    if (nonce.len() != XNONCE_BYTES) || (key.len() != KEY_BYTES) {
        return None;
    }
    return seal(message, ad, nonce, key, true);
}
fn seal<a, b, c, d>(message: &a [u8], ad: &b [u8], nonce: &c [u8], key: &d [u8], extended: bool) -> u8[]? {
    mut body = zeros(message.len());
    mut tag = zeros(TAG_BYTES);
    mut r: i32 = 0;
    unsafe {
        if extended {
            r = crypto_aead_xchacha20poly1305_ietf_encrypt_detached(
                cptr_mut(&mut body), cptr_mut(&mut tag), cnull(), message, ad, cnull(), cptr(nonce), cptr(key));
        } else {
            r = crypto_aead_chacha20poly1305_ietf_encrypt_detached(
                cptr_mut(&mut body), cptr_mut(&mut tag), cnull(), message, ad, cnull(), cptr(nonce), cptr(key));
        }
    }
    if r != 0 {
        return None;
    }
    for i in tag.len() {
        body.push(tag[i]);
    }
    return Some(body);
}

// The plaintext, or None when the tag does not verify (or a length is wrong).
pub fn chacha20poly1305_ietf_decrypt<a, b, c, d>(sealed: &a [u8], ad: &b [u8], nonce: &c [u8], key: &d [u8]) -> u8[]? {
    if (nonce.len() != IETF_NONCE_BYTES) || (key.len() != KEY_BYTES) {
        return None;
    }
    return open(sealed, ad, nonce, key, false);
}
pub fn xchacha20poly1305_ietf_decrypt<a, b, c, d>(sealed: &a [u8], ad: &b [u8], nonce: &c [u8], key: &d [u8]) -> u8[]? {
    if (nonce.len() != XNONCE_BYTES) || (key.len() != KEY_BYTES) {
        return None;
    }
    return open(sealed, ad, nonce, key, true);
}
fn open<a, b, c, d>(sealed: &a [u8], ad: &b [u8], nonce: &c [u8], key: &d [u8], extended: bool) -> u8[]? {
    if sealed.len() < TAG_BYTES {
        return None;
    }
    n := sealed.len() - TAG_BYTES;
    body := sealed[0: n];
    tag := sealed[n: sealed.len()];
    mut out = zeros(n);
    mut r: i32 = 0;
    unsafe {
        if extended {
            r = crypto_aead_xchacha20poly1305_ietf_decrypt_detached(
                cptr_mut(&mut out), cnull(), body, cptr(tag), ad, cptr(nonce), cptr(key));
        } else {
            r = crypto_aead_chacha20poly1305_ietf_decrypt_detached(
                cptr_mut(&mut out), cnull(), body, cptr(tag), ad, cptr(nonce), cptr(key));
        }
    }
    if r != 0 {
        return None;
    }
    return Some(out);
}

// BLAKE2b with an output of 16..64 bytes and an optional key (empty or 16..64 bytes).
pub fn blake2b<a, b>(input: &a [u8], key: &b [u8], out_len: u64) -> u8[]? {
    if (out_len < 16) || (64 < out_len) || ((key.len() != 0) && ((key.len() < 16) || (64 < key.len()))) {
        return None;
    }
    mut out = zeros(out_len);
    mut r: i32 = 0;
    unsafe {
        r = crypto_generichash_blake2b(&mut out, input, key);
    }
    if r != 0 {
        return None;
    }
    return Some(out);
}

pub fn sha256<a>(input: &a [u8]) -> u8[] {
    mut out = zeros(32);
    unsafe {
        crypto_hash_sha256(cptr_mut(&mut out), input);
    }
    return out;
}

// SipHash-2-4 with a 16-byte key: an 8-byte tag.
pub fn siphash24<a, b>(input: &a [u8], key: &b [u8]) -> u8[]? {
    if key.len() != 16 {
        return None;
    }
    mut out = zeros(8);
    unsafe {
        crypto_shorthash_siphash24(cptr_mut(&mut out), input, cptr(key));
    }
    return Some(out);
}

// Poly1305 one-time authenticator with a 32-byte key: a 16-byte tag.
pub fn poly1305<a, b>(input: &a [u8], key: &b [u8]) -> u8[]? {
    if key.len() != 32 {
        return None;
    }
    mut out = zeros(16);
    unsafe {
        crypto_onetimeauth_poly1305(cptr_mut(&mut out), input, cptr(key));
    }
    return Some(out);
}

// X25519: the public key for a 32-byte secret scalar.
pub fn x25519_base<a>(secret: &a [u8]) -> u8[]? {
    if secret.len() != 32 {
        return None;
    }
    mut out = zeros(32);
    mut r: i32 = 0;
    unsafe {
        r = crypto_scalarmult_curve25519_base(cptr_mut(&mut out), cptr(secret));
    }
    if r != 0 {
        return None;
    }
    return Some(out);
}

// X25519 shared secret; None for a wrong length or a low-order public key (all-zero output).
pub fn x25519<a, b>(secret: &a [u8], public: &b [u8]) -> u8[]? {
    if (secret.len() != 32) || (public.len() != 32) {
        return None;
    }
    mut out = zeros(32);
    mut r: i32 = 0;
    unsafe {
        r = crypto_scalarmult_curve25519(cptr_mut(&mut out), cptr(secret), cptr(public));
    }
    if r != 0 {
        return None;
    }
    return Some(out);
}

// ChaCha20 (IETF, 12-byte nonce) keystream XOR starting at block `counter`.
pub fn chacha20_ietf_xor<a, b, c>(input: &a [u8], nonce: &b [u8], counter: u32, key: &c [u8]) -> u8[]? {
    if (nonce.len() != IETF_NONCE_BYTES) || (key.len() != KEY_BYTES) {
        return None;
    }
    mut out = zeros(input.len());
    unsafe {
        crypto_stream_chacha20_ietf_xor_ic(cptr_mut(&mut out), input, cptr(nonce), counter, cptr(key));
    }
    return Some(out);
}

// HChaCha20: a 32-byte subkey from a 16-byte input and a 32-byte key.
pub fn hchacha20<a, b>(input: &a [u8], key: &b [u8]) -> u8[]? {
    if (input.len() != 16) || (key.len() != 32) {
        return None;
    }
    mut out = zeros(32);
    unsafe {
        crypto_core_hchacha20(cptr_mut(&mut out), cptr(input), cptr(key), cnull());
    }
    return Some(out);
}
