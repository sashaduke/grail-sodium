use sodium;

// Reference values: libsodium 1.0.22 on the inputs of RFC 8439 (AEAD 2.8.2, Poly1305 key),
// RFC 7748 6.1 (X25519) and the SipHash reference vector; generated by tests/reference/ref.c.
// main returns the number of failures, so `grail test` fails on any difference.

// Indexing a byte sequence yields the byte as a u64 word.
fn hexval(ch: u64) -> u64 {
    if ch < 58 {
        return ch - 48;
    }
    return ch - 87;
}
fn unhex<a>(text: &a [u8]) -> u8[] {
    mut out = u8[];
    mut i: u64 = 0;
    while i + 1 < text.len() {
        out.push(hexval(text[i]) * 16 + hexval(text[i + 1]));
        i += 2;
    }
    return out;
}
fn same<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn check<a, b>(name: string, got: &a [u8], want: &b [u8]) -> u64 {
    if same(got, want) {
        return 0;
    }
    println("FAIL {}", name);
    return 1;
}
fn check_opt<a>(name: string, got: u8[]?, want: &a [u8]) -> u64 {
    match got {
        Some(bytes) => { return check(name, &bytes, want); },
        None => { println("FAIL {} (None)", name); return 1; }
    }
}
fn counting(start: u64, n: u64) -> u8[] {
    mut out = u8[];
    for i in n {
        out.push(start + i);
    }
    return out;
}

fn main() -> u64 {
    mut failures: u64 = 0;
    if sodium::init() == false {
        println("FAIL init");
        return 1;
    }
    message := "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
    ad := u8[0x50, 0x51, 0x52, 0x53, 0xc0, 0xc1, 0xc2, 0xc3, 0xc4, 0xc5, 0xc6, 0xc7];
    key := counting(0x80, 32);
    nonce := u8[0x07, 0, 0, 0, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47];
    xnonce := counting(0x40, 24);

    sealed := sodium::chacha20poly1305_ietf_encrypt(&message, &ad, &nonce, &key)!;
    failures += check("aead", &sealed, &unhex("d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691"));
    failures += check_opt("aead open", sodium::chacha20poly1305_ietf_decrypt(&sealed, &ad, &nonce, &key), &message);
    mut tampered = sealed.copy();
    tampered[0] = tampered[0] ^ 1;
    if sodium::chacha20poly1305_ietf_decrypt(&tampered, &ad, &nonce, &key).is_some() {
        println("FAIL aead accepted a tampered ciphertext");
        failures += 1;
    }
    xsealed := sodium::xchacha20poly1305_ietf_encrypt(&message, &ad, &xnonce, &key)!;
    failures += check("xaead", &xsealed, &unhex("bd6d179d3e83d43b9576579493c0e939572a1700252bfaccbed2902c21396cbb731c7f1b0b4aa6440bf3a82f4eda7e39ae64c6708c54c216cb96b72e1213b4522f8c9ba40db5d945b11b69b982c1bb9e3f3fac2bc369488f76b2383565d3fff921f9664c97637da9768812f615c68b13b52ec0875924c1c7987947deafd8780acf49"));
    failures += check_opt("xaead open", sodium::xchacha20poly1305_ietf_decrypt(&xsealed, &ad, &xnonce, &key), &message);
    if sodium::xchacha20poly1305_ietf_encrypt(&message, &ad, &nonce, &key).is_some() {
        println("FAIL xaead accepted a 12-byte nonce");
        failures += 1;
    }

    failures += check_opt("blake2b", sodium::blake2b("abc", u8[], 64), &unhex("ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"));
    failures += check_opt("blake2b keyed", sodium::blake2b("abc", &key, 32), &unhex("8abfd10fed4a3af54cd4fd43bb8615673e0963603ea59db7ac315c42b382ca98"));
    failures += check("sha256", &sodium::sha256("abc"), &unhex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"));
    failures += check_opt("siphash24", sodium::siphash24(&counting(0, 15), &counting(0, 16)), &unhex("e545be4961ca29a1"));
    failures += check_opt("poly1305", sodium::poly1305("Cryptographic Forum Research Group", &key), &unhex("cb2decebc01fb77d7bd5a1af9898b00d"));

    alice := unhex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
    bob := unhex("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb");
    alice_public := sodium::x25519_base(&alice)!;
    failures += check("x25519 base", &alice_public, &unhex("8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"));
    bob_public := sodium::x25519_base(&bob)!;
    failures += check_opt("x25519 shared", sodium::x25519(&alice, &bob_public), &unhex("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"));
    failures += check_opt("x25519 shared (other side)", sodium::x25519(&bob, &alice_public), &unhex("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"));

    failures += check_opt("chacha20 stream", sodium::chacha20_ietf_xor(&message, &nonce, 1, &key), &unhex("d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116"));
    failures += check_opt("hchacha20", sodium::hchacha20(&counting(0, 16), &key), &unhex("27cf9e52305d9778e8ecf6c7f358196becf853454fd8eb52cb5dd8a9b96fdbf0"));

    r := sodium::random_bytes(32);
    if r.len() != 32 {
        failures += 1;
    }
    println("{} failures", failures);
    return failures;
}
